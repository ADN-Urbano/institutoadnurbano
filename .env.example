# Variables de entorno de ADN Local.
# Copia este archivo a .env.local (desarrollo) y configura los mismos valores
# en Vercel (producción). NUNCA commitees .env.local.

# --- Base de datos (Postgres) ---
# Dev local (Postgres de Homebrew vía socket):
#   postgresql://santi@localhost:5432/adnlocal?host=/tmp
# Producción: cadena de conexión de Neon EU (o Supabase). Ej.:
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URI=

# --- Payload ---
# Secreto para firmar sesiones/tokens. Genera uno con: openssl rand -hex 32
PAYLOAD_SECRET=

# URL pública del sitio (para emails y enlaces). En Vercel, la del despliegue.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Servicios externos (se añaden en sus respectivos hitos) ---
# Resend (emails) — hito 4.6
# RESEND_API_KEY=
# Remitente (dominio verificado en Resend). Por defecto: "ADN Local <acceso@adnlocal.es>"
# EMAIL_FROM=
# Stripe — hito 4.4
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Bunny Stream (vídeo) — hito 4.5
# BUNNY_LIBRARY_ID=
# BUNNY_API_KEY=
# Cloudflare R2 (almacenamiento) — hito 4.5
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
